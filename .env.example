# Rayfin generates .env.local from RAYFIN_PUBLIC_* entries in rayfin/.env.
# Add these entries to rayfin/.env; do not edit generated .env.local.
# Register http://localhost:5175 as an SPA redirect origin. Grant delegated
# Workspace.Read.All, Lakehouse.Read.All, Warehouse.Read.All, and
# https://database.windows.net//user_impersonation.
RAYFIN_PUBLIC_FABRIC_ENTRA_CLIENT_ID=<entra-spa-client-id>
RAYFIN_PUBLIC_FABRIC_ENTRA_TENANT_ID=<entra-tenant-id>
# Set after deploying the Azure Functions gateway.
RAYFIN_PUBLIC_RECONCILIATION_GATEWAY_URL=<gateway-https-origin>